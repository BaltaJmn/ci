<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tren de versiones en el Mac (BaltaJmn/ci PUBLICAR.md 7): tren-mac.sh tick cada 30 min. Cada tick lleva un paso mas
       las versiones que arranco release-train (nunca arranca una) y sale enseguida si no hay nada. Si el Mac dormia,
       launchd lo lanza al despertar. Lo instala y lo vuelve a cargar release-train. -->
  <key>Label</key><string>com.baltajmn.tren</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/baltajmn/.tren/ci/tienda/tren-mac.sh</string><string>tick</string></array>
  <key>StartInterval</key><integer>1800</integer>
  <key>StandardOutPath</key><string>/Users/baltajmn/Library/Logs/tren.log</string>
  <key>StandardErrorPath</key><string>/Users/baltajmn/Library/Logs/tren.log</string>
</dict>
</plist>
