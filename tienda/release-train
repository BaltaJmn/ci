#!/bin/zsh
# release-train [estado | log | seco <app>]: the weekly release train by hand (PUBLICAR.md, section 7).
#   release-train            sets up what this Mac is missing (launchd, the claude session the escaparate needs) and starts
#                            a version of every app with changes now, here, with its output on screen. The only way a
#                            version starts. launchd follows it alone from there: Play once Apple approves, the iPhone on
#                            sale once Play publishes. Run again, it only advances what is moving.
#   release-train estado     where each app stands
#   release-train log        follows the train's log
#   release-train seco <app> one app's whole Monday, dry: nothing reaches the stores (flowtime, chroma, quilt, mood)
# Linked from ~/.local/bin/release-train; the train itself runs from ~/.tren/ci, always at origin/main.
set -eu
T=$HOME/.tren P=com.baltajmn.tren LOG=$HOME/Library/Logs/tren.log
plist=$HOME/Library/LaunchAgents/$P.plist

preparar() {
  [[ -d $T/ci ]] || git clone -q https://github.com/BaltaJmn/ci.git $T/ci
  git -C $T/ci fetch -q origin && git -C $T/ci reset -q --hard origin/main
  if ! cmp -s $T/ci/tienda/$P.plist $plist; then   # new or changed: load it again
    mkdir -p ${plist:h} && cp $T/ci/tienda/$P.plist $plist
    launchctl bootout gui/$UID/$P 2>/dev/null || true
  fi
  launchctl print gui/$UID/$P >/dev/null 2>&1 || launchctl bootstrap gui/$UID $plist
  echo "launchd: cada 30 min sigue lo que este en marcha; una version nueva solo sale con release-train"
  if ! claude auth status 2>/dev/null | grep -q '"loggedIn": true'; then
    echo "Sin sesion de claude el escaparate no corre: se abre el navegador para entrar."
    claude auth login
  fi
}

case ${1:-} in
  '') preparar
      # What reviews and Reddit comments asked for and is still open, per app (gk/plan/apps/mejoras/<app>.md, written on the GK35):
      # before the version
      m=$(ssh -o ConnectTimeout=5 gk35 sh -s 2>/dev/null <<'EOF' || true
cd ~/AndroidStudioProjects/gk/plan/apps/mejoras 2>/dev/null || exit 0
for f in *.md; do grep -q '^- \[ \]' "$f" && { echo "${f%.md}:"; grep '^- \[ \]' "$f"; }; done
EOF
)
      if [[ -n $m && -t 0 ]]; then
        print -r -- "Mejoras sin hacer (gk/plan/apps/mejoras/<app>.md en el GK35; marca [x] lo hecho o descartado):"; print -r -- $m
        read -r '?Enter saca la version igual; Ctrl-C para y las atacas antes. '
      fi
      echo "Cada paso sale aqui con su hora; el registro entero de cada uno, en $T/<app>/ (gradle.log, testflight.log, escaparate.log)."
      /bin/zsh $T/ci/tienda/tren-mac.sh ya 2>&1 | tee -a $LOG ;;
  estado) for f in $T/*/estado.json(N); do
            /usr/bin/python3 - $f <<'EOF'
import json, sys
S, c = json.load(open(sys.argv[1])), sys.argv[1].split("/")[-2]
g = lambda k: S.get(k, "-")
print(c + ": " + ("nada nuevo esta semana" if S.get("nada") else "%s (%s), Play %s, iPhone %s" % (g("version"), g("code"), g("play"), g("ios"))))
EOF
          done ;;
  log) tail -n 40 -f $LOG ;;
  seco) /bin/zsh $T/ci/tienda/tren-mac.sh seco ${2:?app: flowtime, chroma, quilt o mood} 2>&1 | tee -a $LOG ;;
  *) sed -n '2,10p' $0; exit 1 ;;
esac
